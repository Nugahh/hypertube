# `make up` copies this file to .env and replaces the password below with a random value.
# Never commit .env.

# URL-safe characters only: it is embedded in DATABASE_URL
POSTGRES_PASSWORD=change-me

# Movie details (summary, cast, length, rating, poster) come from TMDb: free key at https://www.themoviedb.org/settings/api
# (the "API Key" or the "API Read Access Token" both work). Without it the sheets only show what the torrent provides.
TMDB_API_KEY=

# Subtitles from OpenSubtitles (optional): create an account on https://www.opensubtitles.com, then an "API consumer"
# (https://www.opensubtitles.com/consumers) for the key. Username and password are optional (higher download quota).
# Subtitles are only fetched when a member asks for them in the player ("Search OpenSubtitles"), never by themselves.
# Downloads are limited per day (5 per 24 h per IP without an account, 10 with a regular account), searching is not.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Leave empty: the backend reads the key Jackett generated in data/jackett/Jackett/ServerConfig.json
JACKETT_API_KEY=
# Jackett indexer used for the search: `all` asks every indexer added in Jackett, or give the id of one (legal sources only)
JACKETT_INDEXER=all
# Other Jackett indexers searched next to it, comma separated (their ids, see "Copy Torznab Feed" in Jackett).
# Legal sources only (the subject). Their results may be torrent files or magnet links.
# JACKETT_EXTRA_INDEXERS=indexeurpublic1,indexeurpublic2
