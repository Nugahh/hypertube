# `make up` copies this file to .env and replaces the two secrets below with random values.
# Never commit .env.

# Signs the session cookies
SECRET_KEY=change-me
# URL-safe characters only: it is embedded in DATABASE_URL
POSTGRES_PASSWORD=change-me

# Where the password-reset link in the email points (the public address of the site)
APP_URL=http://localhost:3000
# OAuth login. Callback URLs to register on each provider: APP_URL + /api/auth/42/callback and APP_URL + /api/auth/google/callback
# 42: https://profile.intra.42.fr/oauth/applications/new (scope: public only)
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials (OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Movie details (summary, cast, length, rating, poster) come from TMDb: free key at https://www.themoviedb.org/settings/api
# (the "API Key" or the "API Read Access Token" both work). Without it the sheets only show what the torrent provides.
TMDB_API_KEY=

# Subtitles from OpenSubtitles (optional): create an account on https://www.opensubtitles.com, then an "API consumer"
# (https://www.opensubtitles.com/consumers) for the key. Username and password are optional (higher download quota).
# Subtitles are only fetched when a member asks for them in the player ("Search OpenSubtitles"), never by themselves.
# Downloads are limited per day (5 per 24 h per IP without an account, 10 with a regular account), searching is not.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Emails go to Mailpit (http://localhost:8025) by default. For a real SMTP server fill these in:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Hypertube <no-reply@example.com>

# Leave empty: the backend reads the key Jackett generated in data/jackett/Jackett/ServerConfig.json
JACKETT_API_KEY=
# Jackett indexer used for the search (legal sources only)
JACKETT_INDEXER=internetarchive
